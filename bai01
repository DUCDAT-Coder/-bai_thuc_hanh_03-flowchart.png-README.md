#include <stdio.h>
#include <stdlib.h>
#include <time.h>
#define MAX 10000
void taoFile(char *tenFile) {
  FILE *f = fopen(tenFile, "w");
  if (f == NULL) {
    printf("Khong the tao file!\n");
    return;
  }
  srand(time(NULL));
  fprintf(f, "%d\n", MAX);
  for (int i = 0; i < MAX; i++) {
    fprintf(f, "%d ", rand() % 100000);
  }
  fclose(f);
}
void docFile(char *tenFile, int a[], int *n) {
  FILE *f = fopen(tenFile, "r");
  if (f == NULL) {
    printf("Khong the mo file!\n");
    return;
  }
  fscanf(f, "%d", n);
  for (int i = 0; i < *n; i++) {
    fscanf(f, "%d", &a[i]);
  }
  fclose(f);
}
void saoChepMang(int goc[], int dich[], int n) {
  for (int i = 0; i < n; i++) {
    dich[i] = goc[i];
  }
}
void sapXepDoiCho(int a[], int n) {
  for (int i = 0; i < n - 1; i++) {
    for (int j = i + 1; j < n; j++) {
      if (a[i] > a[j]) {
        int temp = a[i];
        a[i] = a[j];
        a[j] = temp;
      }
    }
  }
}
void sapXepChen(int a[], int n) {
  for (int i = 1; i < n; i++) {
    int x = a[i];
    int pos = i - 1;
    while (pos >= 0 && a[pos] > x) {
      a[pos + 1] = a[pos];
      pos--;
    }
    a[pos + 1] = x;
  }
}
int main() {
  char *tenFile = "data.txt";
  int *a = (int *)malloc(MAX * sizeof(int));
  int *b = (int *)malloc(MAX * sizeof(int));
  int n = 0;
  taoFile(tenFile);
  docFile(tenFile, a, &n);
  clock_t start, end;
  double time_spent;
  saoChepMang(a, b, n);
  start = clock();
  sapXepDoiCho(b, n);
  end = clock();
  time_spent = (double)(end - start) / CLOCKS_PER_SEC;
  printf("Thoi gian chay sap xep doi cho: %f giay\n", time_spent);
  saoChepMang(a, b, n);
  start = clock();
  sapXepChen(b, n);
  end = clock();
  time_spent = (double)(end - start) / CLOCKS_PER_SEC;
  printf("Thoi gian chay sap xep chen: %f giay\n", time_spent);
  free(a);
  free(b);
  return 0;
}
