#include <stdio.h>
#include <string.h>
typedef struct SinhVien {
  char ten[50];
  int masv;
  int namSinh;
};
void timTheoTen(SinhVien ds[], int n, char tuKhoa[]) {
  int dem = 0;
  printf("\nKet qua tim kiem cho tu khoa \"%s\":\n", tuKhoa);
  for (int i = 0; i < n; i++) {
    if (strstr(ds[i].ten, tuKhoa) != NULL) {
      printf("- Ma SV: %d | Ten: %s | Nam sinh: %d\n", ds[i].masv, ds[i].ten, ds[i].namSinh);
      dem++;
    }
  }
  if (dem == 0) {
    printf("Khong tim thay sinh vien nao co ten nay!\n");
  }
}
int main() {
  int n;
  printf("Nhap so luong sinh vien (n < 100): ");
  scanf("%d", &n);
  SinhVien ds[100];
  for (int i = 0; i < n; i++) {
    printf("\nNhap thong tin sinh vien thu %d:\n", i + 1);
    printf(" Ma SV (so nguyen): ");
    scanf("%d", &ds[i].masv);
    printf(" Ten: ");
    scanf(" %[^\n]s", ds[i].ten);
    printf("Nam sinh: ");
    scanf("%d", &ds[i].namSinh);
  }
  char tuKhoa[50];
  printf("\nNhap ten sinh vien can tim: ");
  scanf(" %[^\n]s", tuKhoa);
  timTheoTen(ds, n, tuKhoa);
  return 0;
}
  
